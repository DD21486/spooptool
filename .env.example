# Neon Postgres (create project at https://neon.tech, then paste connection string)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Loot webhook: secret for POST /api/loot (Dink sends here). Settings cog on homepage shows the URL.
LOOT_WEBHOOK_SECRET=

# Optional: Discord incoming webhook URL for the loot channel. When a single drop event totals >= 400k gp, SpoopTool posts it here.
# DISCORD_LOOT_WEBHOOK_URL=https://discord.com/api/webhooks/...
