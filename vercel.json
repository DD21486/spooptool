{
  "installCommand": "npm install",
  "buildCommand": "echo 'Static + serverless'",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/loot-webhook-url", "destination": "/api/loot?webhook=1" },
    { "source": "/api/location/post", "destination": "/api/location" },
    { "source": "/api/loot-icon", "destination": "/api/loot?icon=1" },
    { "source": "/api/characters-deltas", "destination": "/api/characters?path=deltas" },
    { "source": "/api/weekly-winners", "destination": "/api/aggregate-history?path=weekly-winners" },
    { "source": "/api/test-leaderboard-webhook", "destination": "/api/loot?testLeaderboard=1" },
    { "source": "/api/player-history", "destination": "/api/player-deltas?path=history" },
    { "source": "/api/character-snapshot", "destination": "/api/characters-with-snapshots" },
    { "source": "/api/ge-prices", "destination": "/api/aggregate-history?path=ge" }
  ]
}
