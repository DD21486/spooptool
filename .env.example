# Neon Postgres (create project at https://neon.tech, then paste connection string)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Loot webhook: secret for POST /api/loot (Dink sends here). Settings cog on homepage shows the URL.
LOOT_WEBHOOK_SECRET=

# Location map: shared key for Live Location Sharing plugin (RuneLite).
# Set this and use the same value in the plugin (API Base URL = your site + /api/location, API Shared key = this value).
# LOCATION_SHARED_KEY=your-secret-key

# Optional: Discord incoming webhook URL for the loot channel. When a single drop event totals >= 400k gp, SpoopTool posts it here.
# DISCORD_LOOT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: Discord webhook for leaderboard notifications. When one player overtakes the boss-kill leader, SpoopTool posts here.
# DISCORD_LEADERBOARD_WEBHOOK_URL=https://discord.com/api/webhooks/...
